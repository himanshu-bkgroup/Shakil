# SAKIL BAG STORE - Environment Variables
# MongoDB Connection (e.g., MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sakil_bag_store?retryWrites=true&w=majority
MONGODB_DB_NAME=sakil_bag_store

# Supabase Configuration (Optional alternative)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Only Keys (Configured in Supabase Dashboard / Edge Functions - Never expose in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GEMINI_API_KEY=your-google-gemini-api-key
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-token
